# YOMNOVA web server configuration (all optional)

# Port for the HTTP server (default: 3000)
PORT=3000

# Path to the compiled `yomnova` CLI used by the Playground API.
# Default: yomnova/target/release/yomnova, falling back to yomnova/target/debug/yomnova
# Build it first:  cd yomnova && cargo build --release
YOMNOVA_BIN=

# ---- YOMNOVA AI Assistant (optional) ---------------------------------------
# The assistant is disabled unless OPENROUTER_API_KEY is set. The key stays on the server.
# Create one at https://openrouter.ai/keys. Never commit a real key.
OPENROUTER_API_KEY=
# Optional: model id pre-selected in the panel (any id from the OpenRouter model list).
OPENROUTER_DEFAULT_MODEL=
# Optional: comma-separated model ids or id prefixes to offer (empty = all text models), e.g. "vendor-a/,vendor-b/model-x".
AI_MODEL_ALLOWLIST=
# Optional tuning (defaults shown): provider timeout, output token cap, rate limits, trust X-Forwarded-For.
# AI_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=1200
# AI_RATE_PER_MINUTE=20
# AI_RATE_PER_HOUR=300
# AI_TRUST_PROXY=0
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_TITLE=YOMNOVA Playground
