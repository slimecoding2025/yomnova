struct P { x: Int, y: Int }
struct Box { p: P, vals: Array<Int> }
fn main() -> Int {
    mut xs = [1, 2, 3]
    xs[1] = 20
    emit(xs)
    mut p = P { x: 1, y: 2 }
    p.x = 10
    emit(p.x + p.y)
    mut b = Box { p: P { x: 5, y: 6 }, vals: [7, 8, 9] }
    b.vals[2] = 90
    b.p.y = 60
    emit(b.vals[2])
    emit(b.p.y)
    mut grid = [[1, 2], [3, 4]]
    grid[1][0] = 33
    emit(grid)
    mut i = 0
    while i < 3 {
        xs[i] = xs[i] * 2
        i = i + 1
    }
    emit(xs)
    return 0
}
