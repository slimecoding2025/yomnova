fn grade(score: Int) -> Text {
    return match score {
        90..=100 => "A",
        80..=89 => "B",
        0..=79 => "C",
        _ => "invalid"
    }
}

fn main() -> Int {
    emit(grade(95))
    emit(grade(80))
    emit(grade(12))
    emit(grade(-4))
    emit(match 7 { -5..=-1 => "negative", 0 | 1..=9 => "digit", n if n > 9 => "big", _ => "other" })
    return 0
}
