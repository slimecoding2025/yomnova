// File import: `import "file.yom" as name`. Only `pub` items of the library are visible,
// used as `name.item`. Run with the CLI: yomnova run examples/modules/main.yom
import "geometry.yom" as geo
import std.math

fn main() -> Int {
    emit(geo.area(3, 4))
    emit(geo.perimeter(3, 4))
    emit(math.max(geo.area(2, 2), 3))
    let r = geo.Rect { w: 5, h: 6 }
    emit(geo.area(r.w, r.h))
    emit(geo.unit())
    return 0
}
