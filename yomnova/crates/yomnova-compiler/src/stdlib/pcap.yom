// std.pcap: read (and build) classic libpcap capture files on a NetworkBuffer.
// Supports the four classic magic numbers (little/big endian, microsecond/nanosecond timestamps).
// pcapng has a minimal reader (pcap_ng_*). Not supported: compressed captures. A capture read through file_read_bytes is limited
// to 1 MiB. Every reader takes a borrowed buffer (`&b`) and never changes it.

// True when the first four bytes are one of the classic pcap magic numbers.
fn pcap_valid(b: &NetworkBuffer) -> Bool {
    if len(b) < 24 {
        return false
    }
    let m = buf_get32(b, 0)
    return m == 2712847316 || m == 3569595041 || m == 2712812621 || m == 1295823521
}

// Big-endian files start with a1 b2 c3 d4 (or a1 b2 3c 4d for nanoseconds).
fn pcap_big_endian(b: &NetworkBuffer) -> Bool {
    let m = buf_get32(b, 0)
    return m == 2712847316 || m == 2712812621
}

fn pcap_u16(b: &NetworkBuffer, off: Int, big: Bool) -> Int {
    if big {
        return buf_get16(b, off)
    }
    return buf_get(b, off) + buf_get(b, off + 1) * 256
}

fn pcap_u32(b: &NetworkBuffer, off: Int, big: Bool) -> Int {
    if big {
        return buf_get32(b, off)
    }
    return buf_get(b, off) + buf_get(b, off + 1) * 256 + buf_get(b, off + 2) * 65536 + buf_get(b, off + 3) * 16777216
}

// Link-layer type: 1 means Ethernet, 101 raw IP.
fn pcap_linktype(b: &NetworkBuffer) -> Int {
    return pcap_u32(&b, 20, pcap_big_endian(&b))
}

fn pcap_snaplen(b: &NetworkBuffer) -> Int {
    return pcap_u32(&b, 16, pcap_big_endian(&b))
}

// Offsets of every complete record header (a record is 16 header bytes plus its captured bytes).
// A truncated last record is left out; see pcap_truncated.
fn pcap_offsets(b: &NetworkBuffer) -> Array<Int> {
    mut out: Array<Int> = []
    if pcap_valid(&b) {
        let big = pcap_big_endian(&b)
        mut off = 24
        while off + 16 <= len(b) {
            let n = pcap_u32(&b, off + 8, big)
            if off + 16 + n > len(b) {
                off = len(b)
            } else {
                out = push(out, off)
                off = off + 16 + n
            }
        }
    }
    return out
}

// True when bytes remain after the last complete record (a cut-off file).
fn pcap_truncated(b: &NetworkBuffer) -> Bool {
    if !pcap_valid(&b) {
        return false
    }
    let big = pcap_big_endian(&b)
    mut off = 24
    while off + 16 <= len(b) {
        let n = pcap_u32(&b, off + 8, big)
        if off + 16 + n > len(b) {
            return true
        }
        off = off + 16 + n
    }
    return off != len(b)
}

fn pcap_count(b: &NetworkBuffer) -> Int {
    return len(pcap_offsets(&b))
}

// The three readers below take an offset from pcap_offsets.
fn pcap_time_at(b: &NetworkBuffer, off: Int) -> Int {
    return pcap_u32(&b, off, pcap_big_endian(&b))
}

fn pcap_orig_length_at(b: &NetworkBuffer, off: Int) -> Int {
    return pcap_u32(&b, off + 12, pcap_big_endian(&b))
}

// The captured bytes of the record (the frame, for linktype 1).
fn pcap_packet_at(b: &NetworkBuffer, off: Int) -> NetworkBuffer {
    let n = pcap_u32(&b, off + 8, pcap_big_endian(&b))
    return buf_slice(b, off + 16, n)
}

// A 24-byte little-endian microsecond header for Ethernet captures.
fn pcap_make_header() -> NetworkBuffer {
    mut h: NetworkBuffer = NetworkBuffer(24)
    h = buf_set(h, 0, 212)
    h = buf_set(h, 1, 195)
    h = buf_set(h, 2, 178)
    h = buf_set(h, 3, 161)
    h = buf_set(h, 4, 2)
    h = buf_set(h, 6, 4)
    h = buf_set(h, 16, 255)
    h = buf_set(h, 17, 255)
    h = buf_set(h, 20, 1)
    return h
}

// The file with one more record appended (little-endian header as made by pcap_make_header).
fn pcap_append(file: NetworkBuffer, seconds: Int, frame: NetworkBuffer) -> NetworkBuffer {
    mut r: NetworkBuffer = NetworkBuffer(16)
    let n = len(frame)
    r = buf_set(r, 0, seconds % 256)
    r = buf_set(r, 1, (seconds / 256) % 256)
    r = buf_set(r, 2, (seconds / 65536) % 256)
    r = buf_set(r, 3, (seconds / 16777216) % 256)
    r = buf_set(r, 8, n % 256)
    r = buf_set(r, 9, (n / 256) % 256)
    r = buf_set(r, 12, n % 256)
    r = buf_set(r, 13, (n / 256) % 256)
    return buf_concat(buf_concat(file, r), frame)
}

// Seconds between the first and the last record's timestamp (0 for fewer than two records).
// Records are taken in file order; a capture whose clock went backwards gives 0.
fn pcap_duration(b: &NetworkBuffer) -> Int {
    let offs = pcap_offsets(&b)
    if len(offs) < 2 {
        return 0
    }
    let span = pcap_time_at(&b, offs[len(offs) - 1]) - pcap_time_at(&b, offs[0])
    if span < 0 {
        return 0
    }
    return span
}

// Total captured bytes of all complete records (frame data only, headers not counted).
fn pcap_captured_bytes(b: &NetworkBuffer) -> Int {
    mut total = 0
    for off in pcap_offsets(&b) {
        total = total + pcap_u32(&b, off + 8, pcap_big_endian(&b))
    }
    return total
}

// ---- pcapng (read only) -------------------------------------------------------------------------
// Minimal pcapng reader: a file that starts with a Section Header Block. Only the first section's
// byte order is used and only Enhanced Packet Blocks (type 6) count as packets; other block types
// (interface descriptions, statistics, name resolution, simple packets) are skipped.

fn pcap_ng_valid(b: &NetworkBuffer) -> Bool {
    if len(b) < 28 {
        return false
    }
    let order = buf_get32(b, 8)
    return buf_get32(b, 0) == 168627466 && (order == 439041101 || order == 1295788826)
}

fn pcap_ng_big_endian(b: &NetworkBuffer) -> Bool {
    return buf_get32(b, 8) == 439041101
}

// Offsets of every Enhanced Packet Block that is complete and well formed. A block with a bad length
// (under 12, not a multiple of 4, or past the end of the file) stops the walk.
fn pcap_ng_offsets(b: &NetworkBuffer) -> Array<Int> {
    mut out: Array<Int> = []
    if pcap_ng_valid(&b) {
        let big = pcap_ng_big_endian(&b)
        mut off = 0
        while off + 12 <= len(b) {
            let kind = pcap_u32(&b, off, big)
            let total = pcap_u32(&b, off + 4, big)
            if total < 12 || total % 4 != 0 || off + total > len(b) {
                off = len(b)
            } else {
                if kind == 6 && total >= 32 {
                    out = push(out, off)
                }
                off = off + total
            }
        }
    }
    return out
}

fn pcap_ng_count(b: &NetworkBuffer) -> Int {
    return len(pcap_ng_offsets(&b))
}

// Captured bytes of the Enhanced Packet Block at `off` (an offset from pcap_ng_offsets); empty when
// the stated captured length does not fit inside the block.
fn pcap_ng_packet_at(b: &NetworkBuffer, off: Int) -> NetworkBuffer {
    let big = pcap_ng_big_endian(&b)
    let total = pcap_u32(&b, off + 4, big)
    let n = pcap_u32(&b, off + 20, big)
    if 28 + n + 4 > total {
        return buf_slice(b, off, 0)
    }
    return buf_slice(b, off + 28, n)
}
