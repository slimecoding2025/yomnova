// std.net: parse and build IPv4, UDP and TCP headers on a NetworkBuffer.
// Written in YOMNOVA. Offsets follow the RFCs; all multi-byte fields are big-endian.
// Every reader takes a borrowed buffer (`&b`) that starts at that protocol's header.
// Out-of-range reads are bounds errors from buf_get*, never silent zeros.

fn net_from_bytes(xs: &Array<Int>) -> NetworkBuffer {
    mut b: NetworkBuffer = NetworkBuffer(len(xs))
    mut i = 0
    while i < len(xs) {
        b = buf_set(b, i, xs[i])
        i = i + 1
    }
    return b
}

fn net_to_bytes(b: &NetworkBuffer) -> Array<Int> {
    mut out: Array<Int> = []
    mut i = 0
    while i < len(b) {
        out = push(out, buf_get(b, i))
        i = i + 1
    }
    return out
}

fn net_ipv4_version(b: &NetworkBuffer) -> Int {
    return buf_get(b, 0) / 16
}

fn net_ipv4_header_len(b: &NetworkBuffer) -> Int {
    return (buf_get(b, 0) % 16) * 4
}

fn net_ipv4_total_length(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 2)
}

fn net_ipv4_ttl(b: &NetworkBuffer) -> Int {
    return buf_get(b, 8)
}

fn net_ipv4_protocol(b: &NetworkBuffer) -> Int {
    return buf_get(b, 9)
}

fn net_ipv4_src(b: &NetworkBuffer) -> IPv4 {
    return IPv4(str_from_int(buf_get(b, 12)) + "." + str_from_int(buf_get(b, 13)) + "." + str_from_int(buf_get(b, 14)) + "." + str_from_int(buf_get(b, 15)))
}

fn net_ipv4_dst(b: &NetworkBuffer) -> IPv4 {
    return IPv4(str_from_int(buf_get(b, 16)) + "." + str_from_int(buf_get(b, 17)) + "." + str_from_int(buf_get(b, 18)) + "." + str_from_int(buf_get(b, 19)))
}

// Ones-complement checksum of the header with the checksum field (bytes 10..12) taken as zero.
fn net_ipv4_compute_checksum(b: &NetworkBuffer) -> Int {
    let n = (buf_get(b, 0) % 16) * 4
    mut sum = 0
    mut i = 0
    while i < n {
        if i != 10 {
            sum = sum + buf_get16(b, i)
        }
        i = i + 2
    }
    while sum > 65535 {
        sum = (sum % 65536) + (sum / 65536)
    }
    return 65535 - sum
}

fn net_ipv4_checksum_ok(b: &NetworkBuffer) -> Bool {
    return buf_get16(b, 10) == net_ipv4_compute_checksum(&b)
}

// True when this really is a well-formed IPv4 header: version 4, at least 20 header bytes, a total length that
// covers the header and fits in the buffer, and a correct checksum. The readers above only check bounds;
// call this first on bytes you did not build yourself.
fn net_ipv4_valid(b: &NetworkBuffer) -> Bool {
    if len(b) < 20 {
        return false
    }
    let hl = net_ipv4_header_len(&b)
    let total = buf_get16(b, 2)
    if buf_get(b, 0) / 16 != 4 {
        return false
    }
    if hl < 20 {
        return false
    }
    if total < hl {
        return false
    }
    if total > len(b) {
        return false
    }
    return net_ipv4_checksum_ok(&b)
}

// Bytes after the header, up to the total length field (buf_slice takes offset and length).
fn net_ipv4_payload(b: &NetworkBuffer) -> NetworkBuffer {
    let hl = net_ipv4_header_len(&b)
    return buf_slice(b, hl, buf_get16(b, 2) - hl)
}

fn net_udp_src_port(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 0)
}

fn net_udp_dst_port(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 2)
}

fn net_udp_length(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 4)
}

fn net_udp_payload(b: &NetworkBuffer) -> NetworkBuffer {
    return buf_slice(b, 8, buf_get16(b, 4) - 8)
}

fn net_tcp_src_port(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 0)
}

fn net_tcp_dst_port(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 2)
}

fn net_tcp_seq(b: &NetworkBuffer) -> Int {
    return buf_get32(b, 4)
}

fn net_tcp_ack(b: &NetworkBuffer) -> Int {
    return buf_get32(b, 8)
}

fn net_tcp_header_len(b: &NetworkBuffer) -> Int {
    return (buf_get(b, 12) / 16) * 4
}

fn net_tcp_fin(b: &NetworkBuffer) -> Bool {
    return buf_get(b, 13) % 2 == 1
}

fn net_tcp_syn(b: &NetworkBuffer) -> Bool {
    return (buf_get(b, 13) / 2) % 2 == 1
}

fn net_tcp_rst(b: &NetworkBuffer) -> Bool {
    return (buf_get(b, 13) / 4) % 2 == 1
}

fn net_tcp_psh(b: &NetworkBuffer) -> Bool {
    return (buf_get(b, 13) / 8) % 2 == 1
}

fn net_tcp_ack_flag(b: &NetworkBuffer) -> Bool {
    return (buf_get(b, 13) / 16) % 2 == 1
}

fn net_tcp_payload(b: &NetworkBuffer) -> NetworkBuffer {
    let hl = net_tcp_header_len(&b)
    return buf_slice(b, hl, len(b) - hl)
}

// An 8-byte UDP header followed by the payload (checksum 0 = "not computed", legal over IPv4).
fn net_make_udp(src_port: Int, dst_port: Int, payload: NetworkBuffer) -> NetworkBuffer {
    mut h: NetworkBuffer = NetworkBuffer(8)
    h = buf_set16(h, 0, src_port)
    h = buf_set16(h, 2, dst_port)
    h = buf_set16(h, 4, 8 + len(payload))
    return buf_concat(h, payload)
}

// A 20-byte IPv4 header (no options, DF clear, ID 0) with a correct checksum, then the payload.
// Addresses are dotted text such as "192.168.0.1".
fn net_make_ipv4(src: Text, dst: Text, protocol: Int, ttl: Int, payload: NetworkBuffer) -> NetworkBuffer {
    let s = str_split(src, ".")
    let d = str_split(dst, ".")
    mut h: NetworkBuffer = NetworkBuffer(20)
    h = buf_set(h, 0, 69)
    h = buf_set16(h, 2, 20 + len(payload))
    h = buf_set(h, 8, ttl)
    h = buf_set(h, 9, protocol)
    h = buf_set(h, 12, str_parse_int(s[0]))
    h = buf_set(h, 13, str_parse_int(s[1]))
    h = buf_set(h, 14, str_parse_int(s[2]))
    h = buf_set(h, 15, str_parse_int(s[3]))
    h = buf_set(h, 16, str_parse_int(d[0]))
    h = buf_set(h, 17, str_parse_int(d[1]))
    h = buf_set(h, 18, str_parse_int(d[2]))
    h = buf_set(h, 19, str_parse_int(d[3]))
    let ck = net_ipv4_compute_checksum(&h)
    h = buf_set16(h, 10, ck)
    return buf_concat(h, payload)
}

// ---------------------------------------------------------------------------------------------
// Hex helpers, Ethernet II and IPv6 (fixed 40-byte header; extension headers are not parsed).
// ---------------------------------------------------------------------------------------------

fn net_hex_digit(c: &Text) -> Int {
    let i = str_find("0123456789abcdef", str_lower(c))
    if i < 0 {
        fail("invalid hexadecimal digit")
    }
    return i
}

// Up to four hex digits (one 16-bit group, or one byte of a MAC address).
fn net_hex_val(s: &Text) -> Int {
    if len(s) == 0 {
        fail("empty hexadecimal group")
    }
    if len(s) > 4 {
        fail("hexadecimal group longer than 4 digits")
    }
    mut n = 0
    mut i = 0
    while i < len(s) {
        let c = str_slice(s, i, i + 1)
        n = n * 16 + net_hex_digit(&c)
        i = i + 1
    }
    return n
}

fn net_hex_byte(n: Int) -> Text {
    let d = "0123456789abcdef"
    return str_slice(d, n / 16, n / 16 + 1) + str_slice(d, n % 16, n % 16 + 1)
}

fn net_hex_group(n: Int) -> Text {
    return net_hex_byte(n / 256) + net_hex_byte(n % 256)
}

fn net_mac_text(b: &NetworkBuffer, off: Int) -> Text {
    return net_hex_byte(buf_get(b, off)) + ":" + net_hex_byte(buf_get(b, off + 1)) + ":" + net_hex_byte(buf_get(b, off + 2)) + ":" + net_hex_byte(buf_get(b, off + 3)) + ":" + net_hex_byte(buf_get(b, off + 4)) + ":" + net_hex_byte(buf_get(b, off + 5))
}

fn net_mac_bytes(s: &Text) -> Array<Int> {
    let parts = str_split(s, ":")
    if len(parts) != 6 {
        fail("a MAC address has six bytes, like aa:bb:cc:dd:ee:ff")
    }
    mut out: Array<Int> = []
    for p in parts {
        out = push(out, net_hex_val(&p))
    }
    return out
}

fn net_eth_dst(b: &NetworkBuffer) -> Text {
    return net_mac_text(&b, 0)
}

fn net_eth_src(b: &NetworkBuffer) -> Text {
    return net_mac_text(&b, 6)
}

// 2048 (0x0800) IPv4, 34525 (0x86DD) IPv6, 2054 (0x0806) ARP.
fn net_eth_type(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 12)
}

fn net_eth_payload(b: &NetworkBuffer) -> NetworkBuffer {
    return buf_slice(b, 14, len(b) - 14)
}

fn net_make_ethernet(dst: Text, src: Text, ethertype: Int, payload: NetworkBuffer) -> NetworkBuffer {
    let d = net_mac_bytes(&dst)
    let s = net_mac_bytes(&src)
    mut h: NetworkBuffer = NetworkBuffer(14)
    mut i = 0
    while i < 6 {
        h = buf_set(h, i, d[i])
        h = buf_set(h, 6 + i, s[i])
        i = i + 1
    }
    h = buf_set16(h, 12, ethertype)
    return buf_concat(h, payload)
}

// The eight 16-bit groups of an IPv6 address written as text, with or without `::`.
fn net_ipv6_groups(s: &Text) -> Array<Int> {
    mut out: Array<Int> = []
    let at = str_find(s, "::")
    if at < 0 {
        for p in str_split(s, ":") {
            out = push(out, net_hex_val(&p))
        }
    } else {
        let left = str_slice(s, 0, at)
        let right = str_slice(s, at + 2, len(s))
        mut l: Array<Int> = []
        mut r: Array<Int> = []
        if len(left) > 0 {
            for p in str_split(left, ":") {
                l = push(l, net_hex_val(&p))
            }
        }
        if len(right) > 0 {
            for p in str_split(right, ":") {
                r = push(r, net_hex_val(&p))
            }
        }
        if len(l) + len(r) > 7 {
            fail("invalid IPv6 address: `::` must stand for at least one group")
        }
        for x in l {
            out = push(out, x)
        }
        mut z = 8 - len(l) - len(r)
        while z > 0 {
            out = push(out, 0)
            z = z - 1
        }
        for x in r {
            out = push(out, x)
        }
    }
    if len(out) != 8 {
        fail("invalid IPv6 address: expected 8 groups")
    }
    return out
}

fn net_v6_text(b: &NetworkBuffer, off: Int) -> Text {
    return net_hex_group(buf_get16(b, off)) + ":" + net_hex_group(buf_get16(b, off + 2)) + ":" + net_hex_group(buf_get16(b, off + 4)) + ":" + net_hex_group(buf_get16(b, off + 6)) + ":" + net_hex_group(buf_get16(b, off + 8)) + ":" + net_hex_group(buf_get16(b, off + 10)) + ":" + net_hex_group(buf_get16(b, off + 12)) + ":" + net_hex_group(buf_get16(b, off + 14))
}

fn net_ipv6_version(b: &NetworkBuffer) -> Int {
    return buf_get(b, 0) / 16
}

fn net_ipv6_traffic_class(b: &NetworkBuffer) -> Int {
    return (buf_get(b, 0) % 16) * 16 + buf_get(b, 1) / 16
}

fn net_ipv6_flow_label(b: &NetworkBuffer) -> Int {
    return (buf_get(b, 1) % 16) * 65536 + buf_get16(b, 2)
}

fn net_ipv6_payload_length(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 4)
}

// 6 TCP, 17 UDP, 58 ICMPv6 (the first header after the fixed one; extension headers are not walked).
fn net_ipv6_next_header(b: &NetworkBuffer) -> Int {
    return buf_get(b, 6)
}

fn net_ipv6_hop_limit(b: &NetworkBuffer) -> Int {
    return buf_get(b, 7)
}

fn net_ipv6_src(b: &NetworkBuffer) -> IPv6 {
    return IPv6(net_v6_text(&b, 8))
}

fn net_ipv6_dst(b: &NetworkBuffer) -> IPv6 {
    return IPv6(net_v6_text(&b, 24))
}

fn net_ipv6_payload(b: &NetworkBuffer) -> NetworkBuffer {
    return buf_slice(b, 40, buf_get16(b, 4))
}

fn net_ipv6_valid(b: &NetworkBuffer) -> Bool {
    if len(b) < 40 {
        return false
    }
    if buf_get(b, 0) / 16 != 6 {
        return false
    }
    return 40 + buf_get16(b, 4) <= len(b)
}

fn net_make_ipv6(src: Text, dst: Text, next_header: Int, hop_limit: Int, payload: NetworkBuffer) -> NetworkBuffer {
    let s = net_ipv6_groups(&src)
    let d = net_ipv6_groups(&dst)
    mut h: NetworkBuffer = NetworkBuffer(40)
    h = buf_set(h, 0, 96)
    h = buf_set16(h, 4, len(payload))
    h = buf_set(h, 6, next_header)
    h = buf_set(h, 7, hop_limit)
    mut i = 0
    while i < 8 {
        h = buf_set16(h, 8 + 2 * i, s[i])
        h = buf_set16(h, 24 + 2 * i, d[i])
        i = i + 1
    }
    return buf_concat(h, payload)
}

// ---------------------------------------------------------------------------------------------
// UDP / TCP checksums over IPv4 and IPv6 (RFC 768, 793, 8200 pseudo-headers; RFC 1071 sum).
// Every function takes the whole IP packet (not the segment).
// ---------------------------------------------------------------------------------------------

fn net_fold(sum: Int) -> Int {
    mut s = sum
    while s > 65535 {
        s = (s % 65536) + (s / 65536)
    }
    return s
}

// Sum of the 16-bit words in [from, to); a trailing odd byte counts as the high byte of a word.
// The word at offset `skip` (the checksum field itself) is left out; pass -1 to skip nothing.
fn net_sum_words(b: &NetworkBuffer, from: Int, to: Int, skip: Int) -> Int {
    mut sum = 0
    mut i = from
    while i + 1 < to {
        if i != skip {
            sum = sum + buf_get16(b, i)
        }
        i = i + 2
    }
    if i < to {
        sum = sum + buf_get(b, i) * 256
    }
    return sum
}

fn net_l4_checksum_v4(ip: &NetworkBuffer, csum_off: Int) -> Int {
    let hl = (buf_get(ip, 0) % 16) * 4
    let total = buf_get16(ip, 2)
    let pseudo = buf_get16(ip, 12) + buf_get16(ip, 14) + buf_get16(ip, 16) + buf_get16(ip, 18) + buf_get(ip, 9) + (total - hl)
    return 65535 - net_fold(pseudo + net_sum_words(&ip, hl, total, hl + csum_off))
}

fn net_l4_checksum_v6(ip: &NetworkBuffer, csum_off: Int) -> Int {
    let plen = buf_get16(ip, 4)
    let pseudo = net_sum_words(&ip, 8, 40, 0 - 1) + plen + buf_get(ip, 6)
    return 65535 - net_fold(pseudo + net_sum_words(&ip, 40, 40 + plen, 40 + csum_off))
}

// A UDP checksum that computes to 0 is sent as 0xFFFF (0 means "no checksum" over IPv4).
fn net_nonzero(c: Int) -> Int {
    if c == 0 {
        return 65535
    }
    return c
}

fn net_ipv4_udp_checksum(ip: &NetworkBuffer) -> Int {
    return net_nonzero(net_l4_checksum_v4(&ip, 6))
}

fn net_ipv4_tcp_checksum(ip: &NetworkBuffer) -> Int {
    return net_l4_checksum_v4(&ip, 16)
}

fn net_ipv6_udp_checksum(ip: &NetworkBuffer) -> Int {
    return net_nonzero(net_l4_checksum_v6(&ip, 6))
}

fn net_ipv6_tcp_checksum(ip: &NetworkBuffer) -> Int {
    return net_l4_checksum_v6(&ip, 16)
}

// Over IPv4 a stored UDP checksum of 0 means "not computed", which is accepted here.
fn net_ipv4_udp_checksum_ok(ip: &NetworkBuffer) -> Bool {
    let stored = buf_get16(ip, (buf_get(ip, 0) % 16) * 4 + 6)
    if stored == 0 {
        return true
    }
    return stored == net_ipv4_udp_checksum(&ip)
}

fn net_ipv4_tcp_checksum_ok(ip: &NetworkBuffer) -> Bool {
    return buf_get16(ip, (buf_get(ip, 0) % 16) * 4 + 16) == net_ipv4_tcp_checksum(&ip)
}

// Over IPv6 the UDP checksum is mandatory, so 0 is not accepted.
fn net_ipv6_udp_checksum_ok(ip: &NetworkBuffer) -> Bool {
    return buf_get16(ip, 46) == net_ipv6_udp_checksum(&ip)
}

fn net_ipv6_tcp_checksum_ok(ip: &NetworkBuffer) -> Bool {
    return buf_get16(ip, 56) == net_ipv6_tcp_checksum(&ip)
}

// Return the packet with the UDP/TCP checksum field filled in.
fn net_fill_ipv4_udp_checksum(ip: NetworkBuffer) -> NetworkBuffer {
    let c = net_ipv4_udp_checksum(&ip)
    let off = (buf_get(ip, 0) % 16) * 4 + 6
    return buf_set16(ip, off, c)
}

fn net_fill_ipv4_tcp_checksum(ip: NetworkBuffer) -> NetworkBuffer {
    let c = net_ipv4_tcp_checksum(&ip)
    let off = (buf_get(ip, 0) % 16) * 4 + 16
    return buf_set16(ip, off, c)
}

fn net_fill_ipv6_udp_checksum(ip: NetworkBuffer) -> NetworkBuffer {
    let c = net_ipv6_udp_checksum(&ip)
    return buf_set16(ip, 46, c)
}

fn net_fill_ipv6_tcp_checksum(ip: NetworkBuffer) -> NetworkBuffer {
    let c = net_ipv6_tcp_checksum(&ip)
    return buf_set16(ip, 56, c)
}

// ---------------------------------------------------------------------------------------------
// VLAN (IEEE 802.1Q), ARP (Ethernet/IPv4) and ICMPv4. Call these on the right layer's buffer:
// VLAN readers take the whole Ethernet frame, ARP readers take the ARP packet (net_eth_payload),
// ICMP readers take the ICMP message (the IPv4 payload). ICMPv6 is not covered (its checksum
// needs the IPv6 pseudo-header).
// ---------------------------------------------------------------------------------------------

// 33024 (0x8100) in the Ethernet type field means a 4-byte VLAN tag follows.
fn net_vlan_tagged(b: &NetworkBuffer) -> Bool {
    return len(b) >= 18 && buf_get16(b, 12) == 33024
}

fn net_vlan_id(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 14) % 4096
}

fn net_vlan_priority(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 14) / 8192
}

// The real EtherType (2048 IPv4, 2054 ARP, ...) after the tag.
fn net_vlan_inner_type(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 16)
}

fn net_vlan_payload(b: &NetworkBuffer) -> NetworkBuffer {
    return buf_slice(b, 18, len(b) - 18)
}

fn net_make_vlan(dst: Text, src: Text, vlan_id: Int, priority: Int, inner_type: Int, payload: NetworkBuffer) -> NetworkBuffer {
    if vlan_id < 0 || vlan_id > 4095 || priority < 0 || priority > 7 {
        fail("a VLAN id is 0..4095 and a priority is 0..7")
    }
    let tag = NetworkBuffer(4)
    let tci = priority * 8192 + vlan_id
    let t1 = buf_set16(tag, 0, tci)
    let t2 = buf_set16(t1, 2, inner_type)
    return net_make_ethernet(dst, src, 33024, buf_concat(t2, payload))
}

// ARP over Ethernet/IPv4: 28 bytes. Operation 1 = request, 2 = reply.
fn net_arp_valid(b: &NetworkBuffer) -> Bool {
    if len(b) < 28 {
        return false
    }
    let op = buf_get16(b, 6)
    return buf_get16(b, 0) == 1 && buf_get16(b, 2) == 2048 && buf_get(b, 4) == 6 && buf_get(b, 5) == 4 && (op == 1 || op == 2)
}

fn net_arp_operation(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 6)
}

fn net_arp_sender_mac(b: &NetworkBuffer) -> Text {
    return net_mac_text(&b, 8)
}

fn net_arp_sender_ip(b: &NetworkBuffer) -> IPv4 {
    return IPv4(str_from_int(buf_get(b, 14)) + "." + str_from_int(buf_get(b, 15)) + "." + str_from_int(buf_get(b, 16)) + "." + str_from_int(buf_get(b, 17)))
}

fn net_arp_target_mac(b: &NetworkBuffer) -> Text {
    return net_mac_text(&b, 18)
}

fn net_arp_target_ip(b: &NetworkBuffer) -> IPv4 {
    return IPv4(str_from_int(buf_get(b, 24)) + "." + str_from_int(buf_get(b, 25)) + "." + str_from_int(buf_get(b, 26)) + "." + str_from_int(buf_get(b, 27)))
}

// A gratuitous ARP announces the sender's own address: sender IP equals target IP.
fn net_arp_is_gratuitous(b: &NetworkBuffer) -> Bool {
    return buf_get32(b, 14) == buf_get32(b, 24)
}

fn net_make_arp(operation: Int, sender_mac: Text, sender_ip: Text, target_mac: Text, target_ip: Text) -> NetworkBuffer {
    let sm = net_mac_bytes(&sender_mac)
    let tm = net_mac_bytes(&target_mac)
    let si = str_split(sender_ip, ".")
    let ti = str_split(target_ip, ".")
    mut h: NetworkBuffer = NetworkBuffer(28)
    h = buf_set16(h, 0, 1)
    h = buf_set16(h, 2, 2048)
    h = buf_set(h, 4, 6)
    h = buf_set(h, 5, 4)
    h = buf_set16(h, 6, operation)
    mut i = 0
    while i < 6 {
        h = buf_set(h, 8 + i, sm[i])
        h = buf_set(h, 18 + i, tm[i])
        i = i + 1
    }
    i = 0
    while i < 4 {
        h = buf_set(h, 14 + i, str_parse_int(si[i]))
        h = buf_set(h, 24 + i, str_parse_int(ti[i]))
        i = i + 1
    }
    return h
}

// ICMPv4: type, code, checksum over the whole message. Type 8 = echo request, 0 = echo reply,
// 3 = destination unreachable, 11 = time exceeded.
fn net_icmp_type(b: &NetworkBuffer) -> Int {
    return buf_get(b, 0)
}

fn net_icmp_code(b: &NetworkBuffer) -> Int {
    return buf_get(b, 1)
}

fn net_icmp_checksum_compute(b: &NetworkBuffer) -> Int {
    return 65535 - net_fold(net_sum_words(&b, 0, len(b), 2))
}

fn net_icmp_checksum_ok(b: &NetworkBuffer) -> Bool {
    return len(b) >= 8 && buf_get16(b, 2) == net_icmp_checksum_compute(&b)
}

// Echo request/reply fields.
fn net_icmp_echo_id(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 4)
}

fn net_icmp_echo_seq(b: &NetworkBuffer) -> Int {
    return buf_get16(b, 6)
}

// Everything after the 8-byte ICMP header (for echo: the data; for errors: the quoted IP header).
fn net_icmp_payload(b: &NetworkBuffer) -> NetworkBuffer {
    return buf_slice(b, 8, len(b) - 8)
}

fn net_make_icmp_echo(icmp_type: Int, id: Int, seq: Int, payload: NetworkBuffer) -> NetworkBuffer {
    mut h: NetworkBuffer = NetworkBuffer(8)
    h = buf_set(h, 0, icmp_type)
    h = buf_set16(h, 4, id)
    h = buf_set16(h, 6, seq)
    let msg = buf_concat(h, payload)
    let ck = net_icmp_checksum_compute(&msg)
    return buf_set16(msg, 2, ck)
}
