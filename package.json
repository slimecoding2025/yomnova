{
  "name": "yomnova-site",
  "private": true,
  "version": "0.1.0",
  "description": "YOMNOVA website and Playground (React + Vite + GSAP) with a node:http backend that runs the real yomnova compiler.",
  "license": "MIT OR Apache-2.0",
  "author": "Mouhamed Salim Bousmina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimecoding2025/yomnova.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:compiler": "cargo build --release --manifest-path yomnova/Cargo.toml",
    "start": "tsx server.ts --prod",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
